# Copy to .env.local for local development. Never commit real secrets.

# Resend (https://resend.com) — required to actually send contact-form email.
# Without these two set, /api/contact logs the enquiry to the server console
# instead of sending it (see README "Contact form setup").
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional — defaults to the address in src/content/site.ts (siteSettings.email).
CONTACT_TO_EMAIL=
